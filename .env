# Docker settings for this machine. No secrets.
# Save configurations and recordings as your Linux user (rantzau).
RADAR_UID=1000
RADAR_GID=1000

# Connected radar's command and data USB ports.
RADAR_COMMAND_PORT=/dev/ttyUSB0
RADAR_DATA_PORT=/dev/ttyUSB1

# Allow the container to access the USB ports (Linux dialout group).
RADAR_SERIAL_GID=20
